{
  "manifest_version": 3,
  "name": "BOSS 岗位采集桥",
  "version": "1.3.1",
  "description": "旁听 BOSS 直聘页面的岗位列表与职位详情响应并上报到自建服务，不读取任何登录凭据。",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "https://job.qiubite.fun/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BOSS 岗位采集桥",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.zhipin.com/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ]
}
