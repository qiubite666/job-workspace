# 构建产物（不要入库）
/jobworkspace
/jobworkspace.exe
*.exe
*.dll
*.so
*.dylib
/dist/
/build/

# 运行时数据：本地采集结果，含真实抓取内容，禁止入库
/data/jobs.json
/data/collect.report.json

# 后台账号文件：含密码哈希，属于敏感数据，任何情况下都不得入库
/data/users.json
/data/users.json.tmp
**/users.json

# 本地临时验证产物（截图、注入页、端到端测试目录）
/shot-*.png
/tmp-*.html
/tmp-*.py
/tmp-e2e/

# 本地配置覆盖（可能含私有平台地址、cookie 环境变量名等）
/config/
*.local.json

# 凭据与环境变量（一律不入库；仓库内不提供 .env 白名单）
.env
.env.*
*.env
*.pem
*.key
*.p12
secrets.json

# 编辑器 / 系统 / 缓存
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.log
/tmp/
/.cache/
**/__pycache__/

# 构建时 Windows 可能残留的临时副本
*.exe~
*.exe.old

# 子 agent / 本地验证的临时目录：可能含浏览器 profile、截图、注入页
# 这些内容体积大且可能带 cookie，绝不能入库（曾因 release.sh 的 git add -A 误提交）
/_s6test/
/_s7test/
/.tmp-*/
/tmp-*/
/verify-*/
